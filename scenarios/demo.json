    {"kind": "app.pencil", "every": 3.0, "segments": [{"from": 85, "to": 140, "data": {"strokes": 0, "erases": 1}}]}
  ],
  "events": [
    {"t": 0.5, "kind": "app.session", "data": {"active": true}},
    {"t": 12, "kind": "app.correct"},
    {"t": 55, "kind": "app.stuck", "data": {"conf": 0.8, "region": [0.35, 0.30, 0.25, 0.05]}},
